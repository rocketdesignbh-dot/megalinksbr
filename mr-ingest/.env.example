# mr-ingest — variaveis de ambiente (configurar no EasyPanel)

PORT=8080

# Projeto Supabase compartilhado com o resto do MegaLinks
SUPABASE_URL=https://nxlfezpagporealqqbfj.supabase.co

# SERVICE ROLE, nao a anon: o servico grava em nome do usuario dono do arquivo
# (owner_id chega como parametro) e precisa de bypass de RLS. Nunca expor ao
# navegador nem versionar o valor real.
SUPABASE_SERVICE_ROLE_KEY=

# Token compartilhado com quem chama POST /import (Edge Function ou app).
# Sem ele o servico se recusa a subir — mesma politica do wa-engine.
MR_INGEST_TOKEN=

# Limites de guarda (doc 08 §5)
MAX_FILE_BYTES=209715200
BATCH_SIZE=5000
MAX_ERROR_RATE=0.30
